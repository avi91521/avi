<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alexandra's Shop - Premium Lifestyle Products</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #0f0f23 0%, #1a1a2e 50%, #16213e 100%);
            color: #ffffff;
            line-height: 1.6;
            overflow-x: hidden;
            min-height: 100vh;
        }

        .container {
            max-width: 400px;
            margin: 0 auto;
            padding: 20px;
            min-height: 100vh;
            position: relative;
        }

        /* Hero Section */
        .hero {
            text-align: center;
            padding: 40px 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%);
            border-radius: 24px;
            margin-bottom: 30px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.1);
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
        }

        .profile-img {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            object-fit: cover;
            margin-bottom: 20px;
            border: 4px solid rgba(255,255,255,0.2);
            box-shadow: 0 10px 30px rgba(0,0,0,0.4);
            transition: all 0.3s ease;
        }

        .profile-img:hover {
            transform: scale(1.05);
            border-color: rgba(255,255,255,0.4);
        }

        .username {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 8px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .bio {
            font-size: 16px;
            color: #b8b8d0;
            margin-bottom: 24px;
            font-weight: 300;
        }

        .cta-hero {
            background: linear-gradient(135deg, #ff6b6b 0%, #feca57 100%);
            color: #000;
            border: none;
            padding: 16px 32px;
            border-radius: 50px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 10px 30px rgba(255,107,107,0.4);
            text-decoration: none;
            display: inline-block;
        }

        .cta-hero:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(255,107,107,0.6);
        }

        /* Products Section */
        .section-title {
            font-size: 24px;
            font-weight: 600;
            text-align: center;
            margin: 40px 0 30px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .products-grid {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-bottom: 30px;
        }

        .product-card {
            background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%);
            border-radius: 20px;
            padding: 20px;
            border: 1px solid rgba(255,255,255,0.1);
            backdrop-filter: blur(10px);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            cursor: pointer;
            overflow: hidden;
            position: relative;
        }

        .product-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #ff6b6b, #feca57, #48cae4);
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 25px 50px rgba(0,0,0,0.4);
            border-color: rgba(255,255,255,0.2);
        }

        .product-card:hover::before {
            transform: scaleX(1);
        }

        .product-image {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 16px;
            margin-bottom: 16px;
            transition: transform 0.3s ease;
        }

        .product-card:hover .product-image {
            transform: scale(1.05);
        }

        .product-title {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .product-desc {
            color: #b8b8d0;
            font-size: 14px;
            margin-bottom: 16px;
            font-weight: 300;
        }

        .price {
            font-size: 24px;
            font-weight: 700;
            color: #feca57;
            margin-bottom: 16px;
        }

        .cta-product {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 25px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            width: 100%;
            text-decoration: none;
            display: block;
            text-align: center;
        }

        .cta-product:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(102,126,234,0.4);
        }

        /* Featured Product */
        .featured {
            background: linear-gradient(135deg, rgba(255,107,107,0.2) 0%, rgba(254,202,87,0.2) 100%);
            border: 2px solid rgba(255,107,107,0.3);
        }

        /* Social Proof */
        .social-proof {
            text-align: center;
            margin: 40px 0;
        }

        .testimonials {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 20px;
        }

        .testimonial {
            background: rgba(255,255,255,0.1);
            padding: 16px 24px;
            border-radius: 25px;
            font-size: 14px;
            font-style: italic;
            border: 1px solid rgba(255,255,255,0.1);
        }

        .stars {
            color: #feca57;
            margin-bottom: 10px;
        }

        /* Trust Badges */
        .trust-badges {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin: 30px 0;
            flex-wrap: wrap;
        }

        .badge {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(255,255,255,0.1);
            padding: 12px 20px;
            border-radius: 25px;
            font-size: 12px;
            font-weight: 500;
            border: 1px solid rgba(255,255,255,0.1);
            transition: all 0.3s ease;
        }

        .badge:hover {
            background: rgba(255,255,255,0.2);
            transform: translateY(-2px);
        }

        /* Sticky CTA */
        .sticky-cta {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: linear-gradient(135deg, #ff6b6b 0%, #feca57 100%);
            color: #000;
            padding: 16px 32px;
            border-radius: 50px;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 10px 30px rgba(255,107,107,0.4);
            transition: all 0.3s ease;
            z-index: 1000;
            font-size: 16px;
            text-decoration: none;
            display: none;
        }

        .sticky-cta:hover {
            transform: translateX(-50%) translateY(-3px);
            box-shadow: 0 15px 40px rgba(255,107,107,0.6);
        }

        @media (max-width: 480px) {
            .container {
                padding: 15px;
            }
            
            .sticky-cta {
                display: block;
            }
        }

        /* Animations */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate {
            animation: fadeInUp 0.6s ease forwards;
        }

        /* Instagram Style Elements */
        .insta-gradient {
            background: linear-gradient(45deg, #f09433 0%,#e6683c 25%,#dc2743 50%,#cc2366 75%,#bc1888 100%);
            height: 4px;
            border-radius: 2px;
            margin: 20px auto;
            width: 60px;
        }

        /* Scroll animations */
        .reveal {
            opacity: 0;
            transform: translateY(50px);
            transition: all 0.6s ease;
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Hero Section -->
        <section class="hero reveal">
            <img src="https://images.unsplash.com/photo-1494790108755-2616b612b786?w=400&h=400&fit=crop&crop=face" alt="Alexandra" class="profile-img">
            <div class="username">@alexandra_style</div>
            <p class="bio">Premium lifestyle essentials | Curated just for you ✨</p>
            <a href="#products" class="cta-hero">Shop Now</a>
            <div class="insta-gradient"></div>
        </section>

        <!-- Featured Product -->
        <div class="section-title reveal">🔥 Featured</div>
        <div class="products-grid">
            <div class="product-card featured reveal" data-delay="100">
                <img src="https://images.unsplash.com/photo-1581655353564-df123a1eb820?w=400&h=300&fit=crop" alt="Cashmere Scarf" class="product-image">
                <div class="product-title">Luxury Cashmere Scarf</div>
                <div class="product-desc">Ultra-soft Italian cashmere, perfect for all seasons</div>
                <div class="price">$89</div>
                <a href="#" class="cta-product">Buy Now</a>
            </div>
        </div>

        <!-- Products -->
        <div class="section-title reveal" id="products">Shop Collection</div>
        <div class="products-grid">
            <div class="product-card reveal" data-delay="200">
                <img src="https://images.unsplash.com/photo-1593778459988-6a8784f3dd19?w=400&h=300&fit=crop" alt="Gold Necklace" class="product-image">
                <div class="product-title">18K Gold Layered Necklace</div>
                <div class="product-desc">Timeless elegance with adjustable length</div>
                <div class="price">$149</div>
                <a href="#" class="cta-product">View Product</a>
            </div>

            <div class="product-card reveal" data-delay="300">
                <img src="https://images.unsplash.com/photo-1570987341482-eb19b081b4db?w=400&h=300&fit=crop" alt="Silk Blouse" class="product-image">
                <div class="product-title">Pure Silk Blouse</div>
                <div class="product-desc">Handcrafted from 100% mulberry silk</div>
                <div class="price">$129</div>
                <a href="#" class="cta-product">Buy Now</a>
            </div>

            <div class="product-card reveal" data-delay="400">
                <img src="https://images.unsplash.com/photo-1596462502278-27bfdc403348?w=400&h=300&fit=crop" alt="Leather Bag" class="product-image">
                <div class="product-title">Designer Leather Tote</div>
                <div class="product-desc">Premium full-grain leather, spacious interior</div>
                <div class="price">$299</div>
                <a href="#" class="cta-product">View Product</a>
            </div>

            <div class="product-card reveal" data-delay="500">
                <img src="https://images.unsplash.com/photo-1605348532760-6753d2c43329?w=400&h=300&fit=crop" alt="Sunglasses" class="product-image">
                <div class="product-title">Polarized Sunglasses</div>
                <div class="product-desc">UV400 protection with stylish cat-eye frame</div>
                <div class="price">$79</div>
                <a href="#" class="cta-product">Buy Now</a>
            </div>
        </div>

        <!-- Social Proof -->
        <div class="social-proof reveal" data-delay="600">
            <div class="stars">
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
            </div>
            <div class="testimonials">
                <div class="testimonial">"Obsessed with the scarf! So soft!"</div>
                <div class="testimonial">"Fast shipping, perfect quality"</div>
                <div class="testimonial">"Best necklace I've ever owned"</div>
            </div>
        </div>

        <!-- Trust Badges -->
        <div class="trust-badges reveal" data-delay="700">
            <div class="badge">
                <i class="fas fa-lock"></i>
                <span>Secure Payment</span>
            </div>
            <div class="badge">
                <i class="fas fa-shipping-fast"></i>
                <span>Free Shipping</span>
            </div>
            <div class="badge">
                <i class="fas fa-undo"></i>
                <span>30-Day Returns</span>
            </div>
        </div>
    </div>

    <!-- Sticky CTA for Mobile -->
    <a href="#" class="sticky-cta">🛒 Quick Shop</a>

    <script>
        // Smooth scrolling for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Scroll animations
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry, index) => {
                if (entry.isIntersecting) {
                    setTimeout(() => {
                        entry.target.classList.add('active');
                    }, index * 100);
                }
            });
        }, observerOptions);

        document.querySelectorAll('.reveal').forEach(el => {
            observer.observe(el);
        });

        // Product card click handlers (demo)
        document.querySelectorAll('.product-card').forEach(card => {
            card.addEventListener('click', function(e) {
                if (e.target.tagName !== 'A') {
                    const cta = this.querySelector('.cta-product');
                    if (cta) cta.click();
                }
            });
        });

        // Parallax effect on hero image
        window.addEventListener('scroll', () => {
            const scrolled = window.pageYOffset;
            const heroImg = document.querySelector('.profile-img');
            if (heroImg) {
                heroImg.style.transform = `translateY(${scrolled * 0.5}px)`;
            }
        });

        // Loading animation
        window.addEventListener('load', () => {
            document.body.style.opacity = '0';
            document.body.style.transition = 'opacity 0.5s ease';
            setTimeout(() => {
                document.body.style.opacity = '1';
            }, 100);
        });
    </script>
</body>
</html>
